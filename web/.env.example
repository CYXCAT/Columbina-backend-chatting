# Session signing (generate: openssl rand -base64 48)
JWT_SECRET=
# Agora project. Keep the certificate server-side only.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Google Cloud OAuth "Web application" client ID = ID-token audience (GIDServerClientID in the app)
GOOGLE_CLIENT_IDS=
# Google Cloud OAuth "iOS" client ID(s) = expected azp (GIDClientID in the app); comma-separated
GOOGLE_IOS_CLIENT_IDS=
# iOS bundle identifier (Sign in with Apple audience)
APPLE_BUNDLE_ID=
# Any PostgreSQL-compatible database. Leave empty locally to use embedded PGlite in .pglite/
DATABASE_URL=
# Unity Editor dev sign-in (ignored in production)
ALLOW_DEV_LOGIN=true
