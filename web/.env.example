# Session signing (generate: openssl rand -base64 48)
JWT_SECRET=

# ---- LLM (Vercel AI SDK): deepseek | gateway
LLM_PROVIDER=deepseek
# Model id for the chosen provider. Defaults: deepseek-flash (deepseek), openai/gpt-4.1-mini (gateway)
LLM_MODEL=

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Vercel AI Gateway: any "<provider>/<model>" id, e.g. anthropic/claude-haiku-5-5. On Vercel it
# authenticates with OIDC automatically; set a key only when running elsewhere. The team needs a
# card on file before the Gateway serves requests.
AI_GATEWAY_API_KEY=

# ---- Text-to-speech: inworld | minimax | openai
TTS_PROVIDER=inworld
# Optional voice per reply language (each provider has its own defaults and voice ids)
TTS_VOICE_EN=
TTS_VOICE_ZH=
# PCM sample rate sent to the app (inworld/minimax; openai is always 24000)
TTS_SAMPLE_RATE=24000

# Inworld: the Base64 "Basic" credential from the Inworld Portal, as-is
INWORLD_API_KEY=
INWORLD_MODEL=inworld-tts-2

# MiniMax (use https://api.minimaxi.com for mainland China accounts)
MINIMAX_API_KEY=
MINIMAX_MODEL=speech-2.6-turbo
MINIMAX_BASE_URL=https://api.minimax.io

# OpenAI
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---- Auth and database
# Google Cloud OAuth "Web application" client ID = ID-token audience (GIDServerClientID in the app)
GOOGLE_CLIENT_IDS=
# Google Cloud OAuth "iOS" client ID(s) = expected azp (GIDClientID in the app); comma-separated
GOOGLE_IOS_CLIENT_IDS=
# iOS bundle identifier (Sign in with Apple audience)
APPLE_BUNDLE_ID=
# Any PostgreSQL-compatible database. Leave empty locally to use embedded PGlite in .pglite/
DATABASE_URL=
# Unity Editor dev sign-in (ignored in production)
ALLOW_DEV_LOGIN=true
